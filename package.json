{
  "name": "mealibrio-webapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint:js": "eslint .",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:names": "node scripts/checkNaming.js",
    "lint:boundaries": "node scripts/checkBoundaries.mjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:names && npm run lint:boundaries",
    "test": "vitest",
    "test:all": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "27.4.0",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "39.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "4.1.11"
  }
}
